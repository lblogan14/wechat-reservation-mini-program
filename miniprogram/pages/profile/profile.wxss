.header {
  margin-top: 48rpx;
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
}

.section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.row {
  margin-bottom: 24rpx;
}

.muted {
  color: #888;
  font-size: 26rpx;
}

.muted.block {
  display: block;
  margin-bottom: 24rpx;
}

.field {
  padding: 16rpx 0 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  font-size: 30rpx;
  padding: 12rpx 16rpx;
  background-color: #f1f3f5;
  border-radius: 8rpx;
}

.primary {
  background-color: #0d6efd;
  color: #ffffff;
}

.primary.stack {
  margin-bottom: 16rpx;
}

.secondary {
  background-color: #ffffff;
  color: #0d6efd;
  border: 2rpx solid #0d6efd;
}

.secondary.stack {
  margin-bottom: 16rpx;
}
