<view class="container">
  <view class="header">
    <text class="title">{{title}}</text>
  </view>

  <view class="section">
    <block wx:if="{{signedIn}}">
      <view class="row">
        <text class="muted">openid: {{openidDisplay}}</text>
      </view>
      <button class="secondary" bindtap="onSignOutTap">{{signoutCta}}</button>
    </block>
    <block wx:else>
      <view class="row">
        <text class="muted">{{notLoggedIn}}</text>
      </view>
      <button class="primary" bindtap="onSignInTap">{{signinCta}}</button>
    </block>
  </view>

  <block wx:if="{{signedIn}}">
    <view wx:if="{{isOwner}}" class="section">
      <text class="section-title">{{ownerToolsLabel}}</text>
      <button class="secondary" bindtap="onEditDaycareTap">{{editDaycareLabel}}</button>
    </view>
    <view wx:else class="section">
      <text class="section-title">{{promoteTitle}}</text>
      <text class="muted block">{{promoteHint}}</text>
      <view class="field">
        <text class="label">{{promoteCodeLabel}}</text>
        <input class="input" value="{{promoteCodeInput}}" bindinput="onPromoteCodeInput" placeholder="{{promoteCodePlaceholder}}" />
      </view>
      <button class="secondary" bindtap="onPromoteSubmit" disabled="{{promoting || !promoteCodeInput}}">{{promoteSubmit}}</button>
    </view>
  </block>

  <view class="section">
    <text class="section-title">{{languageLabel}}</text>
    <lang-switcher />
  </view>
</view>
