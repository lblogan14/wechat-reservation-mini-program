.header { padding: 32rpx 0 16rpx; }
.title { font-size: 40rpx; font-weight: 600; }

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
  gap: 16rpx;
}

.row:last-child { border-bottom: none; }

.label {
  width: 144rpx;
  color: #666;
  font-size: 26rpx;
  flex-shrink: 0;
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.value-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 28rpx;
}

.value.price {
  font-weight: 700;
  color: #0d6efd;
}

.muted { color: #888; font-size: 24rpx; }
.muted.small { font-size: 22rpx; }

.chip {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background-color: #f1f3f5;
  color: #666;
}

.chip.confirmed { background-color: #d4edda; color: #155724; }
.chip.checked_in { background-color: #d1ecf1; color: #0c5460; }
.chip.checked_out { background-color: #e2e3e5; color: #383d41; }
.chip.cancelled { background-color: #f8d7da; color: #721c24; }
.chip.no_show { background-color: #fff3cd; color: #856404; }

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 32rpx 0 64rpx;
}

.danger {
  background-color: #dc3545;
  color: #ffffff;
}

.danger.outline {
  background-color: #ffffff;
  color: #dc3545;
  border: 2rpx solid #dc3545;
}

.hint {
  text-align: center;
  padding: 16rpx 0;
}

.owner-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0d6efd;
  padding: 16rpx 0;
  letter-spacing: 0.04em;
}

.owner-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
  flex-wrap: wrap;
}

.owner-save {
  margin: 16rpx 0 8rpx;
}

.primary {
  background-color: #0d6efd;
  color: #ffffff;
}

.primary.tiny,
.ghost.tiny {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
}

.ghost {
  background-color: transparent;
  color: #dc3545;
  border: 2rpx solid #dc3545;
}

.input {
  flex: 1;
  font-size: 28rpx;
  padding: 8rpx 0;
}

.picker { flex: 1; }
.picker-value { font-size: 28rpx; color: #1a1a1a; text-align: right; }
