<view class="container">
  <view class="header"><text class="title">{{titleText}}</text></view>

  <block wx:if="{{booking}}">
    <view class="card">
      <view class="row">
        <text class="label">{{labels.service}}</text>
        <text class="value">{{serviceName}}</text>
      </view>
      <view class="row">
        <text class="label">{{labels.status}}</text>
        <text class="chip {{statusClass}}">{{statusLabel}}</text>
      </view>
      <view class="row">
        <text class="label">{{labels.dates}}</text>
        <view class="value-block">
          <text>{{dropoffStr}}</text>
          <text class="muted small">→</text>
          <text>{{pickupStr}}</text>
        </view>
      </view>
      <view class="row">
        <text class="label">{{labels.nights}}</text>
        <text class="value">{{booking.nights}}</text>
      </view>
      <view class="row">
        <text class="label">{{labels.pets}}</text>
        <text class="value">{{petsStr}}</text>
      </view>
      <view class="row">
        <text class="label">{{labels.price}}</text>
        <text class="value price">¥{{booking.totalPrice}}</text>
      </view>
      <view class="row">
        <text class="label">{{labels.payment}}</text>
        <text class="value">{{paymentStr}}</text>
      </view>
      <view wx:if="{{booking.parentNotes}}" class="row">
        <text class="label">{{labels.notes}}</text>
        <text class="value">{{booking.parentNotes}}</text>
      </view>
      <view wx:if="{{showRecurringNote}}" class="row">
        <text class="muted">{{recurringNote}}</text>
      </view>
    </view>

    <view wx:if="{{isOwnerView}}" class="card">
      <text class="owner-title">{{ownerPanelTitle}}</text>
      <view class="owner-actions">
        <button wx:if="{{ownerCanCheckin}}" class="primary tiny" bindtap="onOwnerCheckin">{{ownerCheckinLabel}}</button>
        <button wx:if="{{ownerCanCheckout}}" class="primary tiny" bindtap="onOwnerCheckout">{{ownerCheckoutLabel}}</button>
        <button wx:if="{{ownerCanNoShow}}" class="ghost tiny" bindtap="onOwnerNoShow">{{ownerNoShowLabel}}</button>
      </view>

      <view class="row">
        <text class="label">{{ownerPaymentSection}}</text>
        <picker class="picker" range="{{ownerPaymentOptions}}" range-key="label" value="{{ownerPaymentIndex}}" bindchange="onPaymentStatusChange">
          <view class="picker-value">{{ownerPaymentOptions[ownerPaymentIndex].label}}</view>
        </picker>
      </view>
      <view class="row">
        <text class="label">{{ownerPaymentNoteLabel}}</text>
        <input class="input" value="{{ownerPaymentNote}}" bindinput="onPaymentNoteInput" placeholder="{{ownerPaymentNotePh}}" />
      </view>
      <button class="primary owner-save" bindtap="onSavePayment" disabled="{{ownerSavingPayment}}">{{ownerPaymentSaveLabel}}</button>
    </view>

    <view class="actions">
      <button wx:if="{{canCancelSingle}}" class="danger" bindtap="onCancelTap">{{cancelLabel}}</button>
      <button wx:if="{{canCancelSeries}}" class="danger outline" bindtap="onCancelSeriesTap">{{cancelSeriesLabel}}</button>
      <view wx:if="{{!canCancelSingle && !isOwnerView}}" class="hint muted">{{cancelBlockedNote}}</view>
    </view>
  </block>
</view>
