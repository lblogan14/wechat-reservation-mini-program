.hero {
  margin-top: 48rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.card-title {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.daycare-photo {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  background-color: #f1f3f5;
  margin-bottom: 24rpx;
}

.daycare-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid #f1f3f5;
}

.info-row:first-of-type {
  border-top: none;
}

.info-label {
  width: 144rpx;
  font-size: 24rpx;
  color: #888;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.info-value.link {
  color: #0d6efd;
}

.tappable {
  cursor: pointer;
}

.muted {
  color: #888;
  font-size: 26rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 64rpx;
}

.actions .primary {
  background-color: #0d6efd;
  color: #ffffff;
}

.actions .secondary {
  background-color: #ffffff;
  color: #0d6efd;
  border: 2rpx solid #0d6efd;
}
