.header { padding: 32rpx 0 16rpx 0; }
.title { font-size: 40rpx; font-weight: 600; }

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.card.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  gap: 24rpx;
  text-align: center;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.muted { color: #888; font-size: 26rpx; }

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}
.row:last-child { border-bottom: none; }

.row.total {
  padding-top: 24rpx;
  border-top: 1rpx solid #e9ecef;
  margin-top: 12rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}

.label.flex { flex: 1; }

.picker { flex: 1; }
.picker-value { font-size: 30rpx; color: #1a1a1a; text-align: right; }

.textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.pet-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.pet-row:last-child { border-bottom: none; }
.pet-row.selected .pet-name { color: #0d6efd; }

.pet-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.pet-name { font-size: 30rpx; font-weight: 500; }
.pet-meta { font-size: 22rpx; color: #888; }

.check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ced4da;
  display: flex;
  align-items: center;
  justify-content: center;
  color: transparent;
  font-size: 30rpx;
}

.check.on {
  background-color: #0d6efd;
  border-color: #0d6efd;
  color: #ffffff;
}

.agreement {
  max-height: 360rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.hint {
  margin-top: 12rpx;
  color: #888;
  font-size: 22rpx;
}

.warning {
  margin-top: 12rpx;
  background-color: #fff3cd;
  color: #856404;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.price {
  font-size: 36rpx;
  font-weight: 700;
  color: #0d6efd;
}

.dow-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.dow-row .label {
  margin-bottom: 12rpx;
  display: block;
}

.dow-chips {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.dow-chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background-color: #f1f3f5;
  color: #333;
  font-size: 26rpx;
}

.dow-chip.on {
  background-color: #0d6efd;
  color: #ffffff;
}

.addon-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
  gap: 16rpx;
}

.addon-row:last-child { border-bottom: none; }

.addon-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.addon-name { font-size: 28rpx; font-weight: 500; }
.addon-desc { font-size: 22rpx; color: #888; }
.addon-meta {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  margin-top: 4rpx;
}
.addon-price { font-size: 24rpx; color: #0d6efd; font-weight: 600; }
.addon-dot { font-size: 24rpx; color: #ccc; }
.addon-basis { font-size: 22rpx; color: #666; }

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.step {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background-color: #f1f3f5;
  color: #0d6efd;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  line-height: 56rpx;
}

.qty {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.actions {
  margin: 32rpx 0 64rpx;
}

.primary {
  background-color: #0d6efd;
  color: #ffffff;
}
