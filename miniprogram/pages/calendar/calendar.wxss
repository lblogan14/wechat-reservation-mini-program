.header { padding: 32rpx 0 16rpx 0; }
.title { font-size: 40rpx; font-weight: 600; }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx;
  text-align: center;
}

.muted { color: #888; font-size: 26rpx; }
.muted.small { font-size: 22rpx; }

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.picker-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.label {
  width: 144rpx;
  font-size: 26rpx;
  color: #666;
}

.picker { flex: 1; }
.picker-value { font-size: 30rpx; color: #1a1a1a; }

.month-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.month-btn {
  font-size: 28rpx;
  color: #0d6efd;
  padding: 8rpx 16rpx;
}

.month-label {
  font-size: 32rpx;
  font-weight: 600;
}

.dow-row {
  display: flex;
  flex-direction: row;
}

.dow {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #888;
  padding: 12rpx 0;
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 6rpx;
}

.cell {
  width: calc((100% - 36rpx) / 7);
  height: 120rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx;
  background-color: #f8f9fa;
}

.cell.out {
  opacity: 0.25;
}

.cell.today {
  outline: 2rpx solid #0d6efd;
}

.cell.open { background-color: #d4edda; }
.cell.low { background-color: #fff3cd; }
.cell.full { background-color: #f8d7da; }
.cell.muted { background-color: #f1f3f5; }

.day {
  font-size: 28rpx;
  font-weight: 600;
}

.cell.full .day { color: #842029; }
.cell.low .day { color: #856404; }
.cell.open .day { color: #155724; }

.remain {
  font-size: 20rpx;
  margin-top: 4rpx;
  color: #444;
}

.loading {
  padding: 64rpx 0;
  text-align: center;
}

.legend {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f3f5;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.dot.open { background-color: #28a745; }
.dot.low { background-color: #ffc107; }
.dot.full { background-color: #dc3545; }

.hint {
  text-align: center;
  padding: 16rpx 0 64rpx;
}
