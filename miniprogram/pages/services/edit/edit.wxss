.header { padding: 32rpx 0 16rpx 0; }
.title { font-size: 40rpx; font-weight: 600; }

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.card.empty {
  padding: 64rpx 32rpx;
  text-align: center;
}

.muted { color: #888; font-size: 26rpx; }

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.field:last-child { border-bottom: none; }

.field.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.field.row .label { margin-bottom: 0; }

.input {
  width: 100%;
  font-size: 30rpx;
  padding: 8rpx 0;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin: 32rpx 0 64rpx;
}

.primary { background-color: #0d6efd; color: #ffffff; }
.danger { background-color: #ffffff; color: #dc3545; border: 2rpx solid #dc3545; }
