.header {
  padding: 32rpx 0 16rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.field:last-child {
  border-bottom: none;
}

.field.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.field.row .label {
  margin-bottom: 0;
}

.req {
  color: #dc3545;
}

.input {
  width: 100%;
  font-size: 30rpx;
  padding: 8rpx 0;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.picker {
  width: 100%;
  padding: 8rpx 0;
}

.picker-value {
  font-size: 30rpx;
  color: #1a1a1a;
}

.photo-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background-color: #f1f3f5;
}

.photo.small {
  width: 120rpx;
  height: 120rpx;
}

.photo.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 60rpx;
  font-weight: 300;
}

.warning {
  margin: 16rpx 0;
  background-color: #fff3cd;
  color: #856404;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.link {
  background-color: transparent;
  color: #0d6efd;
  border: none;
  padding: 0;
  font-size: 28rpx;
  line-height: 1.4;
}

.link::after {
  display: none;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin: 32rpx 0 64rpx;
}

.primary {
  background-color: #0d6efd;
  color: #ffffff;
}

.danger {
  background-color: #ffffff;
  color: #dc3545;
  border: 2rpx solid #dc3545;
}
