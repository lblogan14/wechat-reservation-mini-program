.header {
  padding: 32rpx 0;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx;
  gap: 32rpx;
  color: #888;
  text-align: center;
}

.muted {
  color: #888;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 160rpx;
}

.primary {
  background-color: #0d6efd;
  color: #ffffff;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 64rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #0d6efd;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 96rpx;
  text-align: center;
  padding: 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(13, 110, 253, 0.4);
}

.fab::after {
  display: none;
}
