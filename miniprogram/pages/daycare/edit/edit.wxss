.header {
  padding: 32rpx 0 16rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.card.empty {
  padding: 64rpx 32rpx;
  text-align: center;
}

.muted {
  color: #888;
  font-size: 26rpx;
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f5;
}

.field:last-child {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  font-size: 30rpx;
  padding: 8rpx 0;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.textarea.tall {
  min-height: 240rpx;
}

.picker {
  width: 100%;
  padding: 8rpx 0;
}

.picker-value {
  font-size: 30rpx;
  color: #1a1a1a;
}

.photo-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.photo {
  width: 240rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #f1f3f5;
}

.photo.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 60rpx;
  font-weight: 300;
}

.link {
  background-color: transparent;
  color: #0d6efd;
  border: none;
  padding: 0;
  font-size: 28rpx;
  line-height: 1.4;
}

.link::after {
  display: none;
}

.actions {
  margin: 32rpx 0 64rpx;
}

.section-label {
  display: block;
  padding: 24rpx 0 0;
  color: #0d6efd;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.primary {
  background-color: #0d6efd;
  color: #ffffff;
}
