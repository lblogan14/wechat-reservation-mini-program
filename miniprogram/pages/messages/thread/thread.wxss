.thread {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f6f8;
}

.empty-screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
}

.muted { color: #888; font-size: 26rpx; }

.scroll {
  flex: 1;
  padding: 24rpx 24rpx 16rpx;
}

.empty {
  text-align: center;
  padding: 96rpx 32rpx;
}

.msg-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}

.msg-row.mine {
  justify-content: flex-end;
}

.msg-row.theirs {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.msg-row.mine .bubble {
  background-color: #0d6efd;
}

.body {
  font-size: 28rpx;
  color: #1a1a1a;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-row.mine .body {
  color: #ffffff;
}

.time {
  font-size: 20rpx;
  color: #999;
}

.msg-row.mine .time {
  color: rgba(255, 255, 255, 0.7);
}

.attach {
  width: 100%;
  border-radius: 12rpx;
  background-color: #f1f3f5;
}

.composer {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e9ecef;
}

.input {
  flex: 1;
  background-color: #f1f3f5;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.primary {
  background-color: #0d6efd;
  color: #ffffff;
}

.primary.tiny {
  font-size: 26rpx;
  padding: 8rpx 28rpx;
}
